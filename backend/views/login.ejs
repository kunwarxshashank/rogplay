<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../public/styles/index.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <div class="w-full h-screen bg-zinc-800">
        <h1 class="text-5xl text-white p-10">Login</h1>
        <form method="post" class="p-10 text-white" action="/validate">
            <input class="border 2 bg-zinc-600 ml-2" type="email" name="email" placeholder="Enter email"></input>
            <input class="border-2 bg-zinc-600 ml-2" type="password" name="password"
                placeholder="Enter passwword"></input>
            <input class="border-2 bg-blue-600 ml-2" value="Login" type="submit"></input>
        </form>
    </div>
</body>

</html>